#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,physical-layout = &cannonball_physical_layout;
    };

    cannonball_physical_layout: cannonball_physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default";
        kscan = <&kscan0>;
        transform = <&default_transform>;

	keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100  375  450       0     0     0>
            , <&key_physical_attrs 100 100  375  550       0     0     0>
            , <&key_physical_attrs 100 100  375  650       0     0     0>
            , <&key_physical_attrs 100 100  375  750       0     0     0>
            , <&key_physical_attrs 100 100  275  550       0     0     0>
            , <&key_physical_attrs 100 100  275  650       0     0     0>
            , <&key_physical_attrs 100 100  275  750       0     0     0>
            , <&key_physical_attrs 100 100  175  450       0     0     0>
            , <&key_physical_attrs 100 100  175  550       0     0     0>
            , <&key_physical_attrs 100 100  175  650       0     0     0>
            , <&key_physical_attrs 100 100  175  750       0     0     0>
            , <&key_physical_attrs 100 100  150  325       0     0     0>
            , <&key_physical_attrs 100 100  400  325       0     0     0>
            , <&key_physical_attrs 100 100  275  100       0     0     0>
            , <&key_physical_attrs 100 100  175  200       0     0     0>
            , <&key_physical_attrs 100 100  275  300       0     0     0>
            , <&key_physical_attrs 100 100  375  200       0     0     0>
            , <&key_physical_attrs 100 100    0  150       0     0     0>
            , <&key_physical_attrs 100 100   50   50       0     0     0>
            , <&key_physical_attrs 100 100  150    0       0     0     0>
            , <&key_physical_attrs 100 100  400    0       0     0     0>
            , <&key_physical_attrs 100 100  500   50       0     0     0>
            , <&key_physical_attrs 100 100  550  150       0     0     0>
            , <&key_physical_attrs 100 100   50  500       0     0     0>
            , <&key_physical_attrs 100 100   50  700       0     0     0>
            , <&key_physical_attrs 100 100  500  500       0     0     0>
            , <&key_physical_attrs 100 100  500  700       0     0     0>
            , <&key_physical_attrs 100 100  650  550       0     0     0>
            , <&key_physical_attrs 100 100  650  650       0     0     0>；
    };



    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        rows = <2>;
        columns = <16>;
        map = 
            // Lever
            RC(1,9) RC(1,7) RC(1,6)
            // Stick
            RC(1,0) RC(1,2) RC(1,1) RC(1,3)
            // Cover buttons
            RC(0,11) RC(0,10)
            // Mouse buttons
            RC(0,11) RC(0,10)
            // Main keys
            RC(0,6) RC(1,4) RC(0,0)
            RC(0,7) RC(0,4) RC(0,1)
            RC(0,8) RC(1,5) RC(0,2)
            RC(0,9) RC(0,5) RC(0,3)
            // Side buttons
            RC(0,14) RC(1,14) RC(0,12) RC(0,13)
            // Back buttons
            RC(1,13) RC(1,12)
        >;
    };

    // Rest of the device tree remains the same as in the original overlay
};