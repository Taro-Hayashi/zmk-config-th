#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT_WIN 0
#define DEFAULT_MAC 1
#define SCROLL 2

/ {
    /* Behaviors */
    // スクロール設定

    msc {
        acceleration-exponent = <0>;      // 0
        time-to-max-speed-ms = <200>;     // 300
        delay-ms = <5>;                   // 10
    };

    behaviors {
        // エンコーダー：キー

        rot_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        // エンコーダー：マウススクロール 

        rot_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            tap-ms = <20>;
            bindings = <&msc>, <&msc>;
        };

        // エンコーダー：マウススクロール(MOVE_Y)

        scroll_move_y: sensor_rotate_msc_for_move_y {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc MOVE_Y(20)>, <&msc MOVE_Y(-20)>;

            // tap-ms下限メモ Yの値で可変: Y(15) <81>, Y(20) <65>, Y(25) <49>

            tap-ms = <65>;
        };

        // エンコーダー：マウススクロール(MOVE_Y) 少量

        scroll_move_y_slow: sensor_rotate_msc_for_move_y_slow {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc MOVE_Y(10)>, <&msc MOVE_Y(-10)>;

            tap-ms = <65>;
        };

        // エンコーダー：マウススクロール(MOVE_Y) 大量

        scroll_move_y_fast: sensor_rotate_msc_for_move_y_fast {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc MOVE_Y(40)>, <&msc MOVE_Y(-40)>;

            tap-ms = <65>;
        };

        // エンコーダー：マウススクロール(MOVE_X)

        scroll_move_x: sensor_rotate_msc_for_move_x {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc MOVE_X(20)>, <&msc MOVE_X(-20)>;

            // tap-ms下限メモ Xの値で可変: X(15) <81>, X(20) <65>, X(25) <49>

            tap-ms = <65>;
        };
    };

    /* キーマップ */

    keymap {
        compatible = "zmk,keymap";

        // WINDOWS用

        DEFAULT_WIN {
            bindings = <
&mkp MB2  &kp LCTRL  &kp LSHFT  &kp BSPC  &to 1  &mkp MB3  &to 2  &kp DEL  &mkp MB1  &kp TAB  &kp LS(TAB)  &kp RET  &kp LC(C)  &kp LC(V)  &kp LS(LC(T))  &kp LS(LC(TAB))  &kp LC(W)  &kp LC(TAB)  &to DEFAULT_WIN  &kp F11  &to DEFAULT_MAC  &to DEFAULT_WIN  &kp F12  &to DEFAULT_MAC  &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &mkp MB4  &mkp MB5  &bt BT_SEL 0  &bt BT_SEL 1
            >;

            sensor-bindings =
                <&rot_kp LG(Z) LS(LG(Z))>,
                <&scroll_move_y_fast>,
                <&rot_kp LG(PLUS) LG(MINUS)>;
        };

        // MacOS用

        DEFAULT_MAC {
            bindings = <
&mkp MB2  &kp LGUI  &kp LSHFT  &kp BSPC  &to 0  &mkp MB3  &to 2  &kp DEL  &mkp MB1  &kp TAB  &kp LS(TAB)  &kp RET  &kp LG(C)  &kp LG(V)  &kp LS(LG(T))  &kp LS(LC(TAB))  &kp LG(W)  &kp LC(TAB)  &to DEFAULT_WIN  &kp F11  &to DEFAULT_MAC  &to DEFAULT_WIN  &kp F12  &to DEFAULT_MAC  &kp LG(LA(LEFT_ARROW))  &kp LG(LA(RIGHT))  &kp F3  &kp LG(LS(F4))  &bt BT_SEL 0  &bt BT_SEL 1
            >;

            sensor-bindings =
                <&rot_kp LG(Z) LS(LG(Z))>,
                <&scroll_move_y_fast>,
                <&rot_kp LG(PLUS) LG(MINUS)>;
        };

        // BT設定、スクロールレイヤー

        SETTINGS {
            bindings = <
&kp N9  &kp NUMBER_6  &kp NUMBER_3  &kp COMMA  &to 0  &kp N5  &to 1  &kp PERIOD  &kp N7  &kp NUMBER_4  &kp NUMBER_1  &kp N0  &kp ESCAPE  &kp ENTER  &kp N8  &kp EQUAL  &kp NUMBER_2  &kp BACKSPACE  &none  &none  &none  &none  &none  &none  &kp MINUS  &kp PLUS  &kp SLASH  &kp ASTERISK  &bt BT_CLR_ALL  &bt BT_CLR
            >;

            sensor-bindings =
                <&rot_kp LEFT RIGHT>,
                <&scroll_move_y_slow>,
                <&scroll_move_x>;
        };

        Scrolling {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
